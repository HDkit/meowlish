# Shared environment variables for all application services.
# Copy this file to .env.services and fill in the values.

NODE_ENV=production

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=englishdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RMQ_HOST=rabbit-mq
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# MinIO
MINIO_HOST=min-io
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# JWT (gateway only needs the public key; auth service needs the private key)
JWT_PRIVATE_KEY=change-me
JWT_PUBLIC_KEY=change-me-too
