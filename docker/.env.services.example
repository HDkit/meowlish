# Shared environment variables for all application services.
# Copy this file to .env.services and fill in the values.
# Per-service values (POSTGRES_DB, ports, service hosts) live in docker-compose.app.yaml.

NODE_ENV=production

# Database (each service gets its own POSTGRES_DB, see docker/postgres/init-databases.sql)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RMQ_HOST=rabbit-mq
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# mock-ai-scorer (profile "mock-ai"): uniform random delay before each mock score, min <= max
MOCK_SCORER_MIN_DELAY_MS=2000
MOCK_SCORER_MAX_DELAY_MS=8000

# MinIO (file-service)
MINIO_HOST=min-io
MINIO_PORT=9000
MINIO_USER=minio
MINIO_PASSWORD=minio123

# Gateway public URLs
BASE_URL=http://localhost:8080
FE_LOGIN_REDIRECT_URL=http://localhost:6767/auth/callback

# Comma-separated origins allowed by CORS (gateway + live socket.io); credentials are on, so no "*".
# Unset in production = no cross-origin access.
CORS_ORIGINS=http://localhost:6767
# Number of trusted proxy hops in front of the gateway. The bundled Envoy (use_remote_address: true
# in docker/envoy/gateway.yaml) writes the real client IP into X-Forwarded-For, so 1 throttles per
# client instead of per Envoy. Use false if you remove Envoy.
TRUST_PROXY=1

# Google OAuth2 (auth + gateway). Any non-empty value boots the stack;
# real credentials are only needed for "Login with Google".
GOOGLE_OA2_CLIENT_ID=change-me
GOOGLE_OA2_CLIENT_SECRET=change-me

# JWT RS256 keys (README > JWT / RSA Keys). Wrap the PEM in double quotes and
# keep the newlines. The auth service signs with the private key; the gateway
# only needs the public key.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Signs pagination cursors for auth/exam/achievement/live (>= 32 chars). Unset = random per-process key; set it so cursors survive restarts.
# Generate: openssl rand -hex 32
CURSOR_SECRET=

# OpenTelemetry collector (LGTM stack)
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
