# Shared environment variables for all application services.
# Copy this file to .env.services and fill in the values.
# Per-service values (POSTGRES_DB, ports, service hosts) live in docker-compose.app.yaml.

NODE_ENV=production

# Database (each service gets its own POSTGRES_DB, see docker/postgres/init-databases.sql)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RMQ_HOST=rabbit-mq
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# MinIO (file-service)
MINIO_HOST=min-io
MINIO_PORT=9000
MINIO_USER=minio
MINIO_PASSWORD=minio123

# Gateway public URLs
BASE_URL=http://localhost:8080
FE_LOGIN_REDIRECT_URL=http://localhost:6767

# Google OAuth2 (auth + gateway). Any non-empty value boots the stack;
# real credentials are only needed for "Login with Google".
GOOGLE_OA2_CLIENT_ID=change-me
GOOGLE_OA2_CLIENT_SECRET=change-me

# JWT RS256 keys (README > JWT / RSA Keys). Wrap the PEM in double quotes and
# keep the newlines. The auth service signs with the private key; the gateway
# only needs the public key.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
