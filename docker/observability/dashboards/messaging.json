{
	"uid": "meowlish-messaging",
	"title": "Messaging",
	"tags": ["meowlish"],
	"schemaVersion": 39,
	"version": 1,
	"editable": true,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"panels": [
		{
			"type": "timeseries",
			"title": "Outbox pending events",
			"id": 1,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "max by (service) (outbox_pending_events)",
					"legendFormat": "{{service}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Outbox oldest pending age",
			"id": 2,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 0
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "max by (service) (outbox_oldest_pending_age_seconds)",
					"legendFormat": "{{service}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Outbox publish errors (5m increase)",
			"id": 3,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (service) (increase(outbox_publish_errors_total[5m]))",
					"legendFormat": "{{service}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Inbox duplicates skipped (5m increase)",
			"id": 4,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (service, consumer) (increase(inbox_duplicates_total[5m]))",
					"legendFormat": "{{service}} / {{consumer}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Dead-letter queue depth",
			"id": 5,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 16
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "max by (queue) (rabbitmq_detailed_queue_messages{queue=~\".*\\\\.dlq\"})",
					"legendFormat": "{{queue}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Consumer failures (5m rate)",
			"id": 6,
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 16
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (job, consumer) (rate(consumer_failures_total[5m]))",
					"legendFormat": "{{job}} / {{consumer}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ops",
					"noValue": "no data"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		}
	]
}
