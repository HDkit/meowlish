+"""Band parsing and format retries (python -m unittest discover -s tests, from the repo root)."""
+import asyncio
+import os
+import sys
+import unittest
+from unittest import mock
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "app"))
+
+from schemas.writing import WritingRequest  # noqa: E402
+from services import evaluation_llm  # noqa: E402
+from services.evaluation_llm import LlmParseError, _clean_feedback, _parse_scores  # noqa: E402
+
+STANDARD = """## IELTS Writing Evaluation
+
+### Scores:
+- Overall Band Score: 8.0
+- Task Achievement: 8.0
+- Coherence and Cohesion: 8.5
+- Lexical Resource: 7.5
+- Grammatical Range and Accuracy: 8.0
+
+### Detailed Feedback:
+Good essay."""
+
+# the model's answer for a weak essay
+BOLD_WITH_ABBREVIATIONS = """### IELTS Writing Evaluation
+
+**Score: 3.5**
+
+**Detailed Feedback:**
+- **Task Achievement (TA): 3.5** - While the essay addresses both views...
+- **Coherence and Cohesion (CC): 3** - The essay lacks logical organization...
+- **Lexical Resource (LR): 3** - The vocabulary used is limited...
+- **Grammatical Range and Accuracy (GRA): 3** - The essay contains numerous errors...
+- **Overall Band Score: 3.5** - Considering all criteria..."""
+
+# the Task 1 answer that was saved as band 0
+SCORING_LINE_ONLY = """The essay effectively summarizes the changes. In terms of lexical resource, the essay uses
+appropriate vocabulary.
+
+Scoring: 8.0
+Overall, this essay demonstrates strong task achievement... an 8 out of 9 band score."""
+
+REAL_ZERO = """Overall Band Score: 0
+Task Achievement: 0
+Coherence and Cohesion: 0
+Lexical Resource: 0
+Grammatical Range and Accuracy: 0
+### Detailed Feedback:
+The response is memorised and does not address the question."""
+
+ALL = {"Task Achievement", "Coherence & Cohesion", "Lexical Resource", "Grammatical Range & Accuracy"}
+
+
+class ParseScores(unittest.TestCase):
+    def test_standard_format(self):
+        overall, criteria = _parse_scores(STANDARD)
+        self.assertEqual(overall, 8.0)
+        self.assertEqual(criteria, {"Task Achievement": 8.0, "Coherence & Cohesion": 8.5,
+                                    "Lexical Resource": 7.5, "Grammatical Range & Accuracy": 8.0})
+
+    def test_bold_labels_with_abbreviations(self):
+        overall, criteria = _parse_scores(BOLD_WITH_ABBREVIATIONS)
+        self.assertEqual(overall, 3.5)
+        self.assertEqual(criteria, {"Task Achievement": 3.5, "Coherence & Cohesion": 3.0,
+                                    "Lexical Resource": 3.0, "Grammatical Range & Accuracy": 3.0})
+
+    def test_scoring_line_is_the_overall_band(self):
+        overall, criteria = _parse_scores(SCORING_LINE_ONLY)
+        self.assertEqual(overall, 8.0)
+        self.assertEqual(criteria, {})
+
+    def test_a_real_band_zero_is_kept(self):
+        overall, criteria = _parse_scores(REAL_ZERO)
+        self.assertEqual(overall, 0.0)
+        self.assertEqual(set(criteria), ALL)
+
+    def test_no_band_is_none_not_zero(self):
+        self.assertEqual(_parse_scores("A thoughtful essay with clear paragraphs."), (None, {}))
+
+    def test_overall_from_criteria_rounds_to_half_bands(self):
+        def overall(ta, cc, lr, gra):
+            return _parse_scores(
+                f"Task Achievement: {ta}\nCoherence and Cohesion: {cc}\n"
+                f"Lexical Resource: {lr}\nGrammatical Range and Accuracy: {gra}"
+            )[0]
+        self.assertEqual(overall(6, 6, 6, 6.5), 6.0)   # 6.125
+        self.assertEqual(overall(6, 6.5, 6, 6.5), 6.5)  # 6.25 rounds up
+        self.assertEqual(overall(7, 7, 7, 6.5), 7.0)   # 6.875
+        self.assertEqual(overall(6, 7, 7, 7), 7.0)     # 6.75 rounds up
+
+    def test_a_criterion_score_is_not_the_overall(self):
+        overall, _ = _parse_scores("Task Achievement Score: 7\nThe essay is clear.")
+        self.assertIsNone(overall)
+
+    def test_out_of_range_numbers_are_not_bands(self):
+        self.assertIsNone(_parse_scores("Score: 85")[0])
+
+    def test_leaked_special_tokens_end_the_feedback(self):
+        self.assertEqual(_clean_feedback("Good.<|end_of_document|>\nUnrelated text"), "Good.")
+
+
+class FakeResponse:
+    def __init__(self, text):
+        self._text = text
+
+    def raise_for_status(self):
+        pass
+
+    def json(self):
+        return {"choices": [{"message": {"content": self._text}}]}
+
+
+class Evaluate(unittest.TestCase):
+    def run_with(self, answers, token=""):
+        calls = []
+
+        class Client:
+            async def post(self, url, headers, json):
+                calls.append((headers, json))
+                return FakeResponse(answers[len(calls) - 1])
+
+        request = WritingRequest(
+            attempt_id="a", response_id="r", exam_type="IELTS", task_type="Task 2",
+            question="Discuss both views and give your opinion.", content="word " * 300,
+        )
+        with mock.patch.object(evaluation_llm, "_get_http_client", return_value=Client()), \
+                mock.patch.object(evaluation_llm.settings, "HF_TOKEN", token), \
+                mock.patch.object(evaluation_llm.settings, "LLM_FORMAT_RETRIES", 2), \
+                mock.patch.object(evaluation_llm, "check_word_count_guardrail", return_value=None):
+            result = asyncio.run(evaluation_llm.evaluate_writing_with_local_llm(request))
+        return result, calls
+
+    def test_first_complete_answer_is_used(self):
+        result, calls = self.run_with([STANDARD])
+        self.assertEqual((result.overall_score, len(calls)), (8.0, 1))
+        self.assertNotIn("Authorization", calls[0][0])
+
+    def test_retries_with_a_format_reminder_when_no_band(self):
+        result, calls = self.run_with(["Nice essay, no numbers.", STANDARD])
+        self.assertEqual((result.overall_score, len(calls)), (8.0, 2))
+        self.assertIn("Overall Band Score: <band>", calls[1][1]["messages"][1]["content"])
+        self.assertGreater(calls[1][1]["temperature"], calls[0][1]["temperature"])
+
+    def test_keeps_the_best_answer(self):
+        result, calls = self.run_with([SCORING_LINE_ONLY, "No numbers.", "Still none."])
+        self.assertEqual((result.overall_score, result.sub_scores, len(calls)), (8.0, {}, 3))
+
+    def test_no_band_after_retries_is_an_error_not_band_zero(self):
+        with self.assertRaises(LlmParseError):
+            self.run_with(["No numbers."] * 3)
+
+    def test_sends_the_token_only_when_set(self):
+        _, calls = self.run_with([STANDARD], token="secret")
+        self.assertEqual(calls[0][0]["Authorization"], "Bearer secret")
+
+
+if __name__ == "__main__":
+    unittest.main()
