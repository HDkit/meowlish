+
+# Labels as the model writes them, most specific first. The model is not consistent: it writes
+# "Overall Band Score: 7", "**Score: 3.5**", "Scoring: 8.0", "Task Achievement (TA): 3.5", ...
+_OVERALL_LABELS = [
+    r"Suggested Overall Band Score",
+    r"Overall Band Score",
+    r"Overall Score",
+    r"Overall Band",
+    r"Band Score",
+    # generic words count only at the start of a line ("**Score: 3.5**", "Scoring: 8.0"), so a
+    # criterion line like "Task Achievement Score: 7" is not taken for the overall band
+    r"^[\s#*>\-]*(?:Scoring|Score)",
+]
+_CRITERIA = {
+    "Task Achievement": [r"Task Achievement(?:\s*/\s*Response)?", r"Task Response"],
+    "Coherence & Cohesion": [r"Coherence\s*(?:and|&)\s*Cohesion"],
+    "Lexical Resource": [r"Lexical Resources?"],
+    "Grammatical Range & Accuracy": [r"Grammatical Range\s*(?:and|&)\s*Accuracy", r"Grammar"],
+}
+
+
+def _score_pattern(label: str) -> re.Pattern:
+    # label, optional "(TA)", optional bold markers, optional ":" or "-", then the number
+    return re.compile(
+        rf"(?<![A-Za-z])(?:{label})(?:\s*\([^)]{{0,12}}\))?\s*\**\s*[:\-\u2013]?\s*\**\s*(\d+(?:\.\d+)?)",
+        re.IGNORECASE | re.MULTILINE,
+    )
+
+
+def _to_band(value: float) -> Optional[float]:
+    """A band is 0-9 in half steps; anything else is not a band."""
+    if not 0 <= value <= 9:
+        return None
+    return round(value * 2) / 2
+
+
+def _find_band(labels: list[str], text: str) -> Optional[float]:
+    for label in labels:
+        for match in _score_pattern(label).finditer(text):
+            band = _to_band(float(match.group(1)))
+            if band is not None:
+                return band
+    return None
+
+
+def _overall_from_criteria(scores: Dict[str, float]) -> float:
+    """IELTS overall: mean of the four criteria, rounded to the nearest half band (ties up)."""
+    mean = sum(scores.values()) / len(scores)
+    return math.floor(mean * 2 + 0.5) / 2
+
+
+def _parse_scores(text: str) -> tuple[Optional[float], Dict[str, float]]:
+    criteria = {name: band for name, labels in _CRITERIA.items() if (band := _find_band(labels, text)) is not None}
+    overall = _find_band(_OVERALL_LABELS, text)
+    if overall is None and len(criteria) == len(_CRITERIA):
+        overall = _overall_from_criteria(criteria)
+    return overall, criteria
+
+
+_FORMAT_REMINDER = (
+    "\n\nStart your answer with exactly these five lines, each with a band from 0 to 9:\n"
+    "Overall Band Score: <band>\nTask Achievement: <band>\nCoherence and Cohesion: <band>\n"
+    "Lexical Resource: <band>\nGrammatical Range and Accuracy: <band>\n"
+    "Then write ### Detailed Feedback: followed by your feedback."
+)
+
+
+def _clean_feedback(text: str) -> str:
+    # the model sometimes leaks special tokens ("<|end_of_document|>") and keeps writing after them
+    return re.split(r"<\|[a-z_]+\|>", text, maxsplit=1)[0].strip()
+
+
+def _response_text(response_data) -> str:
+    """The answer text, from an OpenAI-style or a Hugging Face response."""
+    if isinstance(response_data, dict) and response_data.get("choices"):
+        choice = response_data["choices"][0]
+        if "message" in choice:
