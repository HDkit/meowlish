POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_DB=englishdb
POSTGRES_PASSWORD=12345

REDIS_PORT=6380
REDIS_INSIGHT_PORT=8002

ADMINER_PORT=8090

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Public base URL for files (what browsers request). Default: http://localhost:${MINIO_PORT}.
# In production use the host that reverse-proxies to MinIO, e.g. https://api.example.com
# MINIO_PUBLIC_URL=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

PGADM_MAIL=admin@example.com
PGADM_PASS=changeme

RABBITMQ_PORT=5672
RABBITMQ_MNGMNT_PORT=15672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# Envoy sidecar ports
# Envoy ports are published on localhost only (S16): the gRPC-web sidecars skip the gateway's
# checks, so they must not be reachable from other machines. Put a reverse proxy in front of the
# gateway port, or set ENVOY_GATEWAY_BIND_ADDRESS=0.0.0.0 to publish it directly.
# ENVOY_GATEWAY_BIND_ADDRESS=127.0.0.1
# ENVOY_SIDECAR_BIND_ADDRESS=127.0.0.1
ENVOY_GATEWAY_PORT=8080
ENVOY_GATEWAY_ADMIN_PORT=9900
ENVOY_AUTH_PORT=8081
ENVOY_EXAM_PORT=8082
ENVOY_ACHIEVEMENT_PORT=8083
ENVOY_RESOURCE_PORT=8084
ENVOY_NOTIFICATION_PORT=8085
ENVOY_FILE_SERVICE_PORT=8086
ENVOY_LIVE_GRPC_PORT=8087
ENVOY_LIVE_WS_PORT=8088

# Observability stack (docker-compose.observability.yaml)
LGTM_GRAFANA_PORT=3001
LGTM_OTLP_GRPC_PORT=4317
LGTM_OTLP_HTTP_PORT=4318
