		"proto:gen": "pnpm dlx protoc@34.0.0 --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./libs/generated/src/ --ts_proto_opt=nestJs=true --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=outputIndex=true --ts_proto_opt=exportCommonSymbols=true --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=useDate=true -I=./proto ./proto/*.proto",
