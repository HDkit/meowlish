NODE_ENV=development

HOST=localhost
PORT=3000
# public URL of this gateway, and where the FE receives users after Google login
BASE_URL=http://localhost:3000
FE_LOGIN_REDIRECT_URL=http://localhost:6767

# RS256 public key matching auth's JWT_PRIVATE_KEY; keep the quotes
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

GOOGLE_OA2_CLIENT_ID=change-me
GOOGLE_OA2_CLIENT_SECRET=change-me

REDIS_HOST=localhost
REDIS_PORT=6380

# gRPC services (ports match each app's .env.example)
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=50051
AUTHORIZATION_SERVICE_HOST=localhost
AUTHORIZATION_SERVICE_PORT=50052
EXAM_SERVICE_HOST=localhost
EXAM_SERVICE_PORT=50053
ACHIEVEMENT_SERVICE_HOST=localhost
ACHIEVEMENT_SERVICE_PORT=50054
RESOURCE_SERVICE_HOST=localhost
RESOURCE_SERVICE_PORT=50055
FILE_SERVICE_HOST=localhost
FILE_SERVICE_PORT=50056
LIVE_SERVICE_HOST=localhost
LIVE_SERVICE_PORT=50057
LIVE_SERVICE_WS_HOST=localhost
LIVE_SERVICE_WS_PORT=1511
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=50060
NOTIFICATION_SERVICE_HTTP_PORT=50061

# optional *_SERVICE_URL overrides for DNS-based service discovery
# AUTH_SERVICE_URL=

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
