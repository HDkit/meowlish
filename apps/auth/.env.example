# gRPC listen address
HOST=localhost
PORT=50051

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=auth_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/auth_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

FILE_SERVICE_HOST=localhost
FILE_SERVICE_PORT=50056
# optional: full host:port, overrides the two above
# FILE_SERVICE_URL=

# RS256 private key used to sign tokens (README > JWT / RSA Keys); keep the quotes
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# token lifetimes in seconds (defaults: 900 = 15 min, 604800 = 7 days)
# JWT_ACCESS_TOKEN_EXPIRATION=900
# JWT_REFRESH_TOKEN_EXPIRATION=604800

# any non-empty value works unless you test "Login with Google"
GOOGLE_OA2_CLIENT_ID=change-me
GOOGLE_OA2_CLIENT_SECRET=change-me

# Signs pagination cursors (>= 32 chars). If unset, a random per-process key is used (cursors break on restart).
# Generate: openssl rand -hex 32
CURSOR_SECRET=

# HTTP port for /health/live and /health/ready
HEALTH_PORT=9101

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
