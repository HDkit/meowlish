# Stand-in for the external AI writing scorer: random scores after a random delay.
# Do NOT run it next to the real scorer (both would consume exam.writing.submitted).

NODE_ENV=development

# HTTP bind address for /health/live and /health/ready
HOST=localhost

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# Uniform random delay before each score is published (min <= max)
MOCK_SCORER_MIN_DELAY_MS=60000
MOCK_SCORER_MAX_DELAY_MS=180000

# HTTP port for /health/live and /health/ready
HEALTH_PORT=9110

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
