# gRPC + SSE listen addresses
GRPC_HOST=localhost
GRPC_PORT=50060
HTTP_HOST=localhost
HTTP_PORT=50061

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=notification_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/notification_db?schema=public

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
