# gRPC listen address
HOST=localhost
PORT=50054

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=achievement_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/achievement_db?schema=public

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# Signs pagination cursors (>= 32 chars). If unset, a random per-process key is used (cursors break on restart).
# Generate: openssl rand -hex 32
CURSOR_SECRET=
