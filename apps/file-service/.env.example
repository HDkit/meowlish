# gRPC listen address
HOST=localhost
PORT=50056

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=file_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/file_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USER=minio
MINIO_PASSWORD=minio123
# defaults to true only when NODE_ENV=production
MINIO_USE_SSL=false
# browser-facing MinIO address: base of public file links and the host presigned
# upload/download URLs are signed for (default: http(s)://MINIO_HOST:MINIO_PORT)
# MINIO_PUBLIC_URL=http://localhost:9000

# HTTP port for /health/live and /health/ready
HEALTH_PORT=9106

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
