model File {
  id        String   @id @default(uuid())
  name      String
  size      Int
  mimeType  String   @map("mime_type")
  refCount  Int      @default(0) @map("ref_count")
  updatedAt DateTime @default(now()) @updatedAt
  isPublic  Boolean
  // Identity that requested the upload URL; null for legacy, seeded and system files.
  uploadedBy String? @map("uploaded_by")
  // Platform-owned media (seeded content). Only these rows are exempt from orphan cleanup.
  isSystem  Boolean  @default(false) @map("is_system")

  @@index([uploadedBy])
  @@map("files")
}
