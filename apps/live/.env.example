# gRPC + Socket.IO listen addresses
GRPC_HOST=localhost
GRPC_PORT=50057
HTTP_HOST=localhost
HTTP_PORT=1511

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=live_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/live_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# Signs pagination cursors (>= 32 chars). If unset, a random per-process key is used (cursors break on restart).
# Generate: openssl rand -hex 32
CURSOR_SECRET=

# RS256 public key matching auth's JWT_PRIVATE_KEY (same value as the gateway). Keep the quotes.
# Without it every socket connection is rejected.
JWT_PUBLIC_KEY=""

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Comma-separated origins allowed by CORS and socket.io (same list as the gateway; no "*").
# Unset in development = http://localhost:6767,http://localhost:5173; unset in production = none.
CORS_ORIGINS=http://localhost:6767,http://localhost:5173

# auth gRPC: revocation/lock check when a socket connects; AUTH_SERVICE_URL overrides host:port
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=50051
