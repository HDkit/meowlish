# gRPC listen address
HOST=localhost
PORT=50055

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=resource_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/resource_db?schema=public

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

# file-service gRPC (checks who uploaded a file before it is attached to a report)
FILE_SERVICE_HOST=localhost
FILE_SERVICE_PORT=50056
# FILE_SERVICE_URL=

# HTTP port for /health/live and /health/ready
HEALTH_PORT=9104

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
