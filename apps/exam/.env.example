# gRPC listen address
HOST=localhost
PORT=50053

NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=exam_db
# optional; assembled from the POSTGRES_* values above when unset
# POSTGRES_URL=postgresql://postgres:12345@localhost:5433/exam_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_USER=user
RMQ_PASS=password

FILE_SERVICE_HOST=localhost
FILE_SERVICE_PORT=50056

# Signs pagination cursors (>= 32 chars). If unset, a random per-process key is used (cursors break on restart).
# Generate: openssl rand -hex 32
CURSOR_SECRET=

# HTTP port for /health/live and /health/ready
HEALTH_PORT=9102

# OpenTelemetry (set OTEL_SDK_DISABLED=true to turn off)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
